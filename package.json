{
  "name": "control_obra_gastos",
  "version": "2.8.4",
  "description": "Aplicación Web Progresiva (PWA) para el control de gastos y gestión de obra. Personalizable para cualquier empresa con sincronización en la nube.",
  "main": "index.html",
  "scripts": {
    "test": "npm run audit && npm run test:smoke && npm run test:crud && npm run test:reportes && npm run test:reportes:validation",
    "test:smoke": "node test_smoke.js",
    "test:crud": "node test_crud.js",
    "test:automatizado": "node tests-automatizados.js",
    "test:reportes": "node test_reportes.js",
    "test:reportes:validation": "node test_reportes_validation.js",
    "test:ux:files": "node test_ux_files.js",
    "audit": "npm run audit:versions && npm run audit:assets",
    "audit:versions": "node check_versions.js",
    "audit:assets": "node check_assets.js",
    "start": "node server.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/salazaroliveros-prog/construramsa_control.git"
  },
  "keywords": [
    "pwa",
    "control-gastos",
    "gestion-obra",
    "offline",
    "onedrive",
    "sincronizacion"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/salazaroliveros-prog/construramsa_control/issues"
  },
  "homepage": "https://github.com/salazaroliveros-prog/construramsa_control#readme",
  "devDependencies": {
    "playwright": "^1.62.1"
  },
  "dependencies": {
    "playwright-core": "^1.62.1"
  }
}
