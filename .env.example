# ════════════════════════════════════════════════════════════════════════════════════════════════════
#  CONSTRURAMSA Control de Gastos — Variables de Entorno
# ════════════════════════════════════════════════════════════════════════════════════════════════════
#
# Copia este archivo a .env y rellena los valores reales.
# Nunca subas el archivo .env original al repositorio (está en .gitignore).
# ═══════════════════════════════════════════════════════════════════════════════════════════════════

# ── Aplicación ────────────────────────────────────────────────────────────────
APP_NAME=control_obra_gastos
APP_VERSION=2.9.4
PORT=3000
NODE_ENV=production

# ── OneDrive / Microsoft Graph ───────────────────────────────────────────────
# Cliente y secreto de la app registrada en Microsoft Entra ID (Azure AD)
OD_CLIENT_ID=tu_client_id_de_azure_ad
OD_CLIENT_SECRET=tu_client_secret_de_azure_ad
OD_TENANT_ID=tu_tenant_id_de_azure_ad

# Refresh token de OneDrive (se obtiene tras el primer flujo de OAuth)
OD_REFRESH_TOKEN=tu_refresh_token_de_onedrive

# ── Google Apps Script (alternativa a OneDrive) ──────────────────────────────
GAS_URL=https://script.google.com/macros/s/TU_SCRIPT_ID/exec
GAS_TOKEN=tu_token_de_apps_script

# ── Sincronización ───────────────────────────────────────────────────────────
SYNC_ENABLED=true
SYNC_INTERVAL_MS=300000
SYNC_AUTO=true

# ── Notificaciones ───────────────────────────────────────────────────────────
WHATSAPP_API_URL=https://api.whatsapp.com/send
WHATSAPP_TOKEN=tu_token_de_whatsapp

# ── Seguridad ────────────────────────────────────────────────────────────────
SESSION_SECRET=tu_secreto_de_sesion_minimo_32_caracteres
ENCRYPTION_KEY=tu_clave_de_cifrado_32_bytes
