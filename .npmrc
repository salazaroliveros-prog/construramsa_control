# CONFIG LOCAL DEL PROYECTO
# El sistema tiene NODE_ENV=production, que hace que npm añada "dev" a "omit"
# y NO instale las devDependencies (playwright) al ejecutar npm install/ci.
# Este fichero fija omit explícitamente (fuera de "dev") para que la suite de
# pruebas se pueda instalar siempre.
omit=peer
legacy-peer-deps=true
fund=false
audit=false